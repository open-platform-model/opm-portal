# Pins for the e2e fixture cluster. Sourced by test/e2e/lib.sh and read by the E2E workflow.
# Move a pin as one reviewed diff, then recapture testdata/clusters/f1.

# kind release; CI installs it with `go install sigs.k8s.io/kind@$KIND_VERSION`.
KIND_VERSION=v0.32.0
# kind v0.32.0's default node image, pinned so podman and docker run the same Kubernetes.
KIND_NODE_IMAGE=kindest/node:v1.36.1@sha256:3489c7674813ba5d8b1a9977baea8a6e553784dab7b84759d1014dbd78f7ebd5

# Released opm CLI. The sha256 values are copied from the release's checksums.txt; the download
# is compared with them before it is extracted.
OPM_CLI_VERSION=v1.0.0-beta.12
OPM_CLI_SHA256_linux_amd64=995d2ad1fadb99ade5d555e3ca9a188c167ca4b8e8464896d1d789d5c82b143d
OPM_CLI_SHA256_linux_arm64=ad6e353006338947be01894a48b8bd4eb1df1d145b9e6db3f3d66f22a9f3caa6
OPM_CLI_SHA256_darwin_amd64=ce5c6a8c184219b994731eac23881a21354e13d19cc0fc48bb42598f7a1c83b5
OPM_CLI_SHA256_darwin_arm64=de188ec5127c71ee9b67dfa80ea449a5f32c4549cde19cdc7880ab05813e36fa

# opm_controller module version to install, passed to `opm controller install --version`, which
# takes a module version (X.Y.Z pins, vN floats), not the image's release tag. Empty installs the
# version the CLI pins. 0.1.0 is the first module version; it runs a controller on a library that
# accepts the backup provider's claim.
OPM_CONTROLLER_VERSION=0.1.0

# Catalog the cluster Platform subscribes to. up.sh installs the controller with --skip-platform
# and applies a Platform pinned to this version, because `opm controller install` alone subscribes
# to the newest published release.
OPM_CATALOG=opmodel.dev/catalogs/opm@v4
OPM_CATALOG_VERSION=4.6.0
