# Pins for the e2e fixture cluster. Sourced by test/e2e/lib.sh and read by the E2E workflow.
# Move a pin as one reviewed diff, then recapture testdata/clusters/f1.

# kind release; CI installs it with `go install sigs.k8s.io/kind@$KIND_VERSION`.
KIND_VERSION=v0.32.0
# kind v0.32.0's default node image, pinned so podman and docker run the same Kubernetes.
KIND_NODE_IMAGE=kindest/node:v1.36.1@sha256:3489c7674813ba5d8b1a9977baea8a6e553784dab7b84759d1014dbd78f7ebd5

# Released opm CLI. The sha256 values are copied from the release's checksums.txt; the download
# is compared with them before it is extracted.
OPM_CLI_VERSION=v1.0.0-beta.7
OPM_CLI_SHA256_linux_amd64=f9149334d47fef08b38bf4970466f5599a934e6d4fe399567ecdff243e3ffea0
OPM_CLI_SHA256_linux_arm64=82f7530889384b75d5c06243c40e2d261dd61af8fef392ee3c1e65f0c34a7544
OPM_CLI_SHA256_darwin_amd64=8fc934476f32f2368f159eebb5d14590e9d523604f1312d4d3e89c5c5c9f212e
OPM_CLI_SHA256_darwin_arm64=ab9afa2b706f57b23e72f4303cce1d1826c10d7c8c94c4749105f4a69526695a

# opm-operator release to install, passed to `opm operator install --version`. Empty installs
# the version the CLI embeds (v1.0.0-beta.5 for CLI v1.0.0-beta.7). beta.6 is the first release
# on library v1.0.0-beta.4, which accepts the backup provider's claim.
OPM_OPERATOR_VERSION=v1.0.0-beta.6

# Catalog the cluster Platform subscribes to. up.sh installs the operator with --skip-platform
# and applies a Platform pinned to this version, because `opm operator install` alone subscribes
# to the newest published release.
OPM_CATALOG=opmodel.dev/catalogs/opm@v4
OPM_CATALOG_VERSION=4.6.0
